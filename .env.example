# Supabase 대시보드 > Connect (또는 Project Settings > API Keys) 의 Publishable key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# 네이버 클라우드 플랫폼 > Maps > Application 의 Client ID
VITE_NAVER_MAP_CLIENT_ID=your-naver-map-client-id

# 서버 전용. VITE_ 접두사를 붙이면 브라우저 번들에 노출되므로 붙이지 않는다.
NAVER_MAP_CLIENT_SECRET=your-naver-map-client-secret

# 서버 전용 (현재 앱 코드에서는 사용하지 않음)
SUPABASE_SECRET_KEY=sb_secret_your-key
